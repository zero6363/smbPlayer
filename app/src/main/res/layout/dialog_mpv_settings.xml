<?xml version="1.0" encoding="utf-8"?>
<!-- reex 风格设置面板：右侧半透明抽屉，顶部图标网格 + 下方分组横向选项 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 点击空白关闭 -->
    <View
        android:id="@+id/settings_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#33000000" />

    <LinearLayout
        android:id="@+id/settings_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="#990A0A12"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="24dp"
        android:paddingEnd="18dp"
        android:paddingBottom="20dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 顶部功能图标网格：每行 4 个，图标在上文字在下 -->
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alignmentMode="alignMargins"
                    android:columnCount="4"
                    android:rowCount="3"
                    android:useDefaultMargins="false">

                    <LinearLayout android:id="@+id/tile_hwdec" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_gravity="fill" android:gravity="center" android:orientation="vertical" android:padding="10dp">
                        <ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@drawable/ic_hwdec" app:tint="@color/player_control_text" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="硬件解码" android:textColor="@color/player_control_text" android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout android:id="@+id/tile_mirror" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_gravity="fill" android:gravity="center" android:orientation="vertical" android:padding="10dp">
                        <ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@drawable/ic_mirror" app:tint="@color/player_control_text" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="镜像反转" android:textColor="@color/player_control_text" android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout android:id="@+id/tile_background" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_gravity="fill" android:gravity="center" android:orientation="vertical" android:padding="10dp">
                        <ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@drawable/ic_background_play" app:tint="@color/player_control_text" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="后台播放" android:textColor="@color/player_control_text" android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout android:id="@+id/tile_timer" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_gravity="fill" android:gravity="center" android:orientation="vertical" android:padding="10dp">
                        <ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@drawable/ic_timer" app:tint="@color/player_control_text" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="定时器" android:textColor="@color/player_control_text" android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout android:id="@+id/tile_pan" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_gravity="fill" android:gravity="center" android:orientation="vertical" android:padding="10dp">
                        <ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@drawable/ic_pan_scan" app:tint="@color/player_control_text" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="缩放平移" android:textColor="@color/player_control_text" android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout android:id="@+id/tile_display" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_gravity="fill" android:gravity="center" android:orientation="vertical" android:padding="10dp">
                        <ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@drawable/ic_display" app:tint="@color/player_control_text" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="显示" android:textColor="@color/player_control_text" android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout android:id="@+id/tile_pip" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_gravity="fill" android:gravity="center" android:orientation="vertical" android:padding="10dp">
                        <ImageView android:layout_width="30dp" android:layout_height="30dp" android:src="@drawable/ic_pip" app:tint="@color/player_control_text" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="画中画" android:textColor="@color/player_control_text" android:textSize="12sp" />
                    </LinearLayout>
                </GridLayout>

                <!-- 循环 -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="循环" android:textColor="@color/player_control_text_dim" android:textSize="13sp" />
                <LinearLayout android:id="@+id/group_repeat" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView android:id="@+id/repeat_one" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:gravity="center" android:text="单曲" android:textColor="@color/player_control_text" android:textSize="13sp" />
                    <TextView android:id="@+id/repeat_all" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:gravity="center" android:text="顺序" android:textColor="@color/player_control_text" android:textSize="13sp" />
                    <TextView android:id="@+id/repeat_shuffle" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:gravity="center" android:text="随机" android:textColor="@color/player_control_text" android:textSize="13sp" />
                </LinearLayout>

                <!-- 画面尺寸 -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="画面尺寸" android:textColor="@color/player_control_text_dim" android:textSize="13sp" />
                <LinearLayout android:id="@+id/group_aspect" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <TextView android:id="@+id/aspect_fit" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:gravity="center" android:text="适应" android:textColor="@color/player_control_text" android:textSize="13sp" />
                    <TextView android:id="@+id/aspect_169" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:gravity="center" android:text="16:9" android:textColor="@color/player_control_text" android:textSize="13sp" />
                    <TextView android:id="@+id/aspect_43" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:gravity="center" android:text="4:3" android:textColor="@color/player_control_text" android:textSize="13sp" />
                    <TextView android:id="@+id/aspect_fill" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:gravity="center" android:text="填充" android:textColor="@color/player_control_text" android:textSize="13sp" />
                    <TextView android:id="@+id/aspect_crop" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:gravity="center" android:text="裁剪" android:textColor="@color/player_control_text" android:textSize="13sp" />
                </LinearLayout>

                <!-- 定时器 -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="定时器" android:textColor="@color/player_control_text_dim" android:textSize="13sp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView android:id="@+id/tv_sleep" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:gravity="center" android:text="00:00:00" android:textColor="@color/player_control_text" android:textSize="15sp" />
                    <TextView android:id="@+id/sleep_off" android:layout_width="wrap_content" android:layout_height="36dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:gravity="center" android:text="关闭" android:textColor="@color/player_control_text" android:textSize="13sp" />
                    <TextView android:id="@+id/sleep_15" android:layout_width="wrap_content" android:layout_height="36dp" android:paddingStart="12dp" android:paddingEnd="12dp" android:gravity="center" android:text="15分" android:textColor="@color/player_control_text" android:textSize="13sp" />
                    <TextView android:id="@+id/sleep_30" android:layout_width="wrap_content" android:layout_height="36dp" android:paddingStart="12dp" android:gravity="center" android:text="30分" android:textColor="@color/player_control_text" android:textSize="13sp" />
                </LinearLayout>

                <!-- 倍速：1:1 复刻 reex —— 标题 + 数值 + (− 滑块 +) + 刻度档位 -->
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="倍速" android:textColor="@color/player_control_text_dim" android:textSize="13sp" />
                <TextView android:id="@+id/tv_speed_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="1.00" android:textColor="@color/player_control_text" android:textSize="15sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/speed_minus"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:gravity="center"
                        android:text="−"
                        android:textColor="@color/player_control_text"
                        android:textSize="22sp" />

                    <SeekBar
                        android:id="@+id/seek_speed"
                        android:layout_width="0dp"
                        android:layout_height="28dp"
                        android:layout_weight="1"
                        android:max="39"
                        android:progress="3"
                        android:progressDrawable="@drawable/bg_seek_progress"
                        android:thumb="@drawable/bg_seek_thumb"
                        android:splitTrack="false" />

                    <TextView
                        android:id="@+id/speed_plus"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:gravity="center"
                        android:text="+"
                        android:textColor="@color/player_control_text"
                        android:textSize="20sp" />
                </LinearLayout>

                <!-- 档位刻度：当前项蓝色边框高亮 -->
                <LinearLayout
                    android:id="@+id/speed_ticks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView android:id="@+id/tick_0" android:layout_width="0dp" android:layout_height="26dp" android:layout_weight="1" android:gravity="center" android:text="0.5" android:textColor="@color/player_control_text" android:textSize="12sp" />
                    <TextView android:id="@+id/tick_1" android:layout_width="0dp" android:layout_height="26dp" android:layout_weight="1" android:gravity="center" android:text="1.0" android:textColor="@color/player_control_text" android:textSize="12sp" />
                    <TextView android:id="@+id/tick_2" android:layout_width="0dp" android:layout_height="26dp" android:layout_weight="1" android:gravity="center" android:text="1.75" android:textColor="@color/player_control_text" android:textSize="12sp" />
                    <TextView android:id="@+id/tick_3" android:layout_width="0dp" android:layout_height="26dp" android:layout_weight="1" android:gravity="center" android:text="2.0" android:textColor="@color/player_control_text" android:textSize="12sp" />
                    <TextView android:id="@+id/tick_4" android:layout_width="0dp" android:layout_height="26dp" android:layout_weight="1" android:gravity="center" android:text="10.0" android:textColor="@color/player_control_text" android:textSize="12sp" />
                </LinearLayout>

                <!-- 常用倍速快捷切换 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="常用倍速"
                    android:textColor="@color/player_control_text_dim"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <TextView android:id="@+id/speed_preset_0" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:layout_marginEnd="2dp" android:background="@drawable/bg_hint_pill" android:gravity="center" android:text="0.3x" android:textColor="@color/player_control_text" android:textSize="11sp" />
                    <TextView android:id="@+id/speed_preset_1" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:layout_marginEnd="2dp" android:background="@drawable/bg_hint_pill" android:gravity="center" android:text="0.5x" android:textColor="@color/player_control_text" android:textSize="11sp" />
                    <TextView android:id="@+id/speed_preset_2" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:layout_marginEnd="2dp" android:background="@drawable/bg_hint_pill" android:gravity="center" android:text="1x" android:textColor="@color/player_control_text" android:textSize="11sp" />
                    <TextView android:id="@+id/speed_preset_3" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:layout_marginEnd="2dp" android:background="@drawable/bg_hint_pill" android:gravity="center" android:text="1.5x" android:textColor="@color/player_control_text" android:textSize="11sp" />
                    <TextView android:id="@+id/speed_preset_4" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:layout_marginEnd="2dp" android:background="@drawable/bg_hint_pill" android:gravity="center" android:text="2x" android:textColor="@color/player_control_text" android:textSize="11sp" />
                    <TextView android:id="@+id/speed_preset_5" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:layout_marginEnd="2dp" android:background="@drawable/bg_hint_pill" android:gravity="center" android:text="3x" android:textColor="@color/player_control_text" android:textSize="11sp" />
                    <TextView android:id="@+id/speed_preset_6" android:layout_width="0dp" android:layout_height="34dp" android:layout_weight="1" android:background="@drawable/bg_hint_pill" android:gravity="center" android:text="4x" android:textColor="@color/player_control_text" android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
