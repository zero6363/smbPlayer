<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/player_background"
    android:keepScreenOn="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:resize_mode="fit"
        app:surface_type="texture_view"
        app:use_controller="false" />

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:indeterminate="true"
        android:indeterminateTint="@color/player_accent"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/controls"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical">

        <!-- 顶部栏 -->
        <LinearLayout
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/player_scrim"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/back"
                android:src="@drawable/ic_chevron_left"
                app:tint="@color/player_control_text" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <com.smbplayer.app.widget.MarqueeTextView
                    android:id="@+id/tv_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/player_control_text"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <com.smbplayer.app.widget.MarqueeTextView
                    android:id="@+id/tv_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/player_control_text"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btn_speed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_hint_pill"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:text="1.00x"
                android:textColor="@color/on_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_speed_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@color/player_speed_tint"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:textColor="@color/on_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/btn_delete"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/player_delete_current"
                android:src="@drawable/ic_delete"
                app:tint="#FFFF8A80" />

            <ImageButton
                android:id="@+id/btn_orientation"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/orientation_toggle"
                android:src="@drawable/ic_screen_rotation"
                app:tint="@color/player_control_text" />

            <ImageButton
                android:id="@+id/btn_playlist"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/player_playlist"
                android:src="@drawable/ic_playlist_play"
                app:tint="@color/player_control_text" />
        </LinearLayout>

        <!-- 中间空白：点击隐藏/显示控制条 -->
        <FrameLayout
            android:id="@+id/tap_area"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true" />

        <!-- 底部控制栏 -->
        <LinearLayout
            android:id="@+id/bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/player_scrim"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/tv_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="4dp"
                android:textColor="#FFFF8A80"
                android:textSize="13sp"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_position"
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="00:00"
                    android:textColor="@color/player_control_text"
                    android:textSize="12sp" />

                <SeekBar
                    android:id="@+id/seek_progress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:max="1000"
                    android:progressBackgroundTint="@color/player_seek_buffered"
                    android:progressTint="@color/player_seek_played"
                    android:splitTrack="false"
                    android:thumbTint="@color/player_seek_thumb" />

                <TextView
                    android:id="@+id/tv_duration"
                    android:layout_width="64dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="00:00"
                    android:textColor="@color/player_control_text"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- 主播放控制行：上一个 / 后退 / 播放暂停 / 前进 / 下一个 -->
            <LinearLayout
                android:id="@+id/button_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingTop="4dp">

                <ImageButton
                    android:id="@+id/btn_prev_video"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/player_prev"
                    android:src="@drawable/ic_skip_previous"
                    app:tint="@color/player_control_text" />

                <ImageButton
                    android:id="@+id/btn_rew"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/btn_rew"
                    android:src="@drawable/ic_fast_rewind"
                    app:tint="@color/player_control_text" />

                <ImageButton
                    android:id="@+id/btn_play_pause"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:layout_weight="1.3"
                    android:background="@drawable/bg_play_circle"
                    android:contentDescription="@string/btn_play_pause"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_play"
                    app:tint="@color/player_control_text" />

                <ImageButton
                    android:id="@+id/btn_ffwd"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/btn_ffwd"
                    android:src="@drawable/ic_fast_forward"
                    app:tint="@color/player_control_text" />

                <ImageButton
                    android:id="@+id/btn_next_video"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/player_next"
                    android:src="@drawable/ic_skip_next"
                    app:tint="@color/player_control_text" />
            </LinearLayout>

            <!-- 帧工具行：上一帧 / 下一帧 / 导出当前帧，整组可点并带文字标签 -->
            <LinearLayout
                android:id="@+id/frame_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingTop="4dp">

                <LinearLayout
                    android:id="@+id/group_frame_prev"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <ImageButton
                        android:id="@+id/btn_keyframe_prev"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="@null"
                        android:clickable="false"
                        android:contentDescription="@string/keyframe_prev"
                        android:focusable="false"
                        android:src="@drawable/ic_frame_prev"
                        app:tint="@color/player_control_text" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/keyframe_prev"
                        android:textColor="@color/player_control_text_dim"
                        android:textSize="10sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/group_frame_next"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <ImageButton
                        android:id="@+id/btn_keyframe_next"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="@null"
                        android:clickable="false"
                        android:contentDescription="@string/keyframe_next"
                        android:focusable="false"
                        android:src="@drawable/ic_frame_next"
                        app:tint="@color/player_control_text" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/keyframe_next"
                        android:textColor="@color/player_control_text_dim"
                        android:textSize="10sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/group_frame_save"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp">

                    <ImageButton
                        android:id="@+id/btn_keyframe_save"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="@null"
                        android:clickable="false"
                        android:contentDescription="@string/keyframe_save"
                        android:focusable="false"
                        android:src="@drawable/ic_photo_save"
                        app:tint="#FFFFC107" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/keyframe_save"
                        android:textColor="@color/player_control_text_dim"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 按钮操作提示：放底部居中，避免挡住画面（控制条隐藏时下移） -->
    <TextView
        android:id="@+id/tv_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="168dp"
        android:background="@drawable/bg_hint_pill"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:textColor="@color/on_primary"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- 字幕叠加层：播前解析好的字幕按 currentPosition 渲染，控制条显示时上移避让 -->
    <TextView
        android:id="@+id/tv_subtitle_overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="148dp"
        android:background="@drawable/bg_hint_pill"
        android:clickable="false"
        android:focusable="false"
        android:gravity="center"
        android:maxLines="3"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:textColor="@color/on_primary"
        android:textSize="16sp"
        android:visibility="gone" />

</FrameLayout>
