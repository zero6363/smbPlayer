<?xml version="1.0" encoding="utf-8"?>
<!-- 倍速控制：数值 + (− 滑块 +) + 刻度 + 常用倍速快捷。0.25 步进，范围 0.25x~10.0x -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="14dp"
    android:paddingBottom="18dp">

    <TextView
        android:id="@+id/speed_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="1.00x"
        android:textColor="?attr/colorOnSurface"
        android:textSize="24sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/speed_minus"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="−"
            android:textColor="?attr/colorOnSurface"
            android:textSize="26sp" />

        <SeekBar
            android:id="@+id/speed_seek"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:max="39"
            android:progress="3"
            android:progressDrawable="@drawable/bg_seek_progress"
            android:thumb="@drawable/bg_seek_thumb"
            android:splitTrack="false" />

        <TextView
            android:id="@+id/speed_plus"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="+"
            android:textColor="?attr/colorOnSurface"
            android:textSize="24sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView android:id="@+id/speed_tick_0" android:layout_width="0dp" android:layout_height="26dp" android:layout_weight="1" android:gravity="center" android:text="0.5" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="12sp" />
        <TextView android:id="@+id/speed_tick_1" android:layout_width="0dp" android:layout_height="26dp" android:layout_weight="1" android:gravity="center" android:text="1.0" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="12sp" />
        <TextView android:id="@+id/speed_tick_2" android:layout_width="0dp" android:layout_height="26dp" android:layout_weight="1" android:gravity="center" android:text="1.75" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="12sp" />
        <TextView android:id="@+id/speed_tick_3" android:layout_width="0dp" android:layout_height="26dp" android:layout_weight="1" android:gravity="center" android:text="2.0" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="12sp" />
        <TextView android:id="@+id/speed_tick_4" android:layout_width="0dp" android:layout_height="26dp" android:layout_weight="1" android:gravity="center" android:text="10.0" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="常用倍速"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <TextView android:id="@+id/speed_preset_0" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:layout_marginEnd="2dp" android:background="@drawable/bg_hint_pill" android:gravity="center" android:text="0.3x" android:textColor="?attr/colorOnSurface" android:textSize="12sp" />
        <TextView android:id="@+id/speed_preset_1" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:layout_marginEnd="2dp" android:background="@drawable/bg_hint_pill" android:gravity="center" android:text="0.5x" android:textColor="?attr/colorOnSurface" android:textSize="12sp" />
        <TextView android:id="@+id/speed_preset_2" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:layout_marginEnd="2dp" android:background="@drawable/bg_hint_pill" android:gravity="center" android:text="1x" android:textColor="?attr/colorOnSurface" android:textSize="12sp" />
        <TextView android:id="@+id/speed_preset_3" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:layout_marginEnd="2dp" android:background="@drawable/bg_hint_pill" android:gravity="center" android:text="1.5x" android:textColor="?attr/colorOnSurface" android:textSize="12sp" />
        <TextView android:id="@+id/speed_preset_4" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:layout_marginEnd="2dp" android:background="@drawable/bg_hint_pill" android:gravity="center" android:text="2x" android:textColor="?attr/colorOnSurface" android:textSize="12sp" />
        <TextView android:id="@+id/speed_preset_5" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:layout_marginEnd="2dp" android:background="@drawable/bg_hint_pill" android:gravity="center" android:text="3x" android:textColor="?attr/colorOnSurface" android:textSize="12sp" />
        <TextView android:id="@+id/speed_preset_6" android:layout_width="0dp" android:layout_height="36dp" android:layout_weight="1" android:background="@drawable/bg_hint_pill" android:gravity="center" android:text="4x" android:textColor="?attr/colorOnSurface" android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
